#!/bin/bash
#
# Copy missing vendor-signed Qualcomm firmware from a Windows driver store.
# Required filenames come from the running device tree.
#
# Modes
#   --stage DIR       Live ISO, before the disk is touched: scan the Windows
#                     partitions and save the missing files under DIR (the
#                     installer copies DIR into the target). Missing firmware
#                     is reported without aborting staging. A rerun adds the
#                     files earlier runs did not find.
#   --install         Installed system or the installer's chroot: take each
#                     file from the stage (--stage-dir, default
#                     /var/lib/omarchy/firmware-stage), else from a Windows
#                     partition still on an internal disk, write them under
#                     /usr/lib/firmware/updates, record a manifest, add the
#                     zap shader to the initramfs, and rebuild the boot image
#                     (unless --no-rebuild). This is the default mode.
#   --list-missing    Print the device-tree firmware names not present under
#                     /usr/lib/firmware and not listed for this board (below),
#                     one per line. Needs no root.
#   --retire          Remove the copies an earlier --install put under
#                     /usr/lib/firmware/updates once packaged firmware holds
#                     every file of their device-tree node, so the packaged
#                     set loads instead of a mix of versions. A node's copies
#                     go together, and only if each is one the manifest
#                     records, unchanged since. Pacman hooks run this when
#                     packaged Qualcomm firmware changes and when this
#                     package is installed or upgraded.
#   -d DIR            Use DIR as the driver store (a Windows/System32/
#                     DriverStore/FileRepository directory, or any directory
#                     tree holding the files) instead of the Windows
#                     partitions. --install then ignores the stage.
#
# When a driver store holds several copies of one firmware, identical bytes
# are used as they are. Differing copies are chosen by the SoC ids in each
# MBN/ELF hash segment, compared with this machine's chip id
# (/sys/devices/soc0/soc_id, or the device-tree compatible when that file is
# not the id the signature carries). A "_pa" filename is used only when those
# signatures do not decide and the chip is known. If nothing matches, the
# file is skipped and the candidates and chip ids are named. An installed
# companion image, then the newest Windows driver package, still break the
# ties the signatures do not.
#
# Files land in /usr/lib/firmware/updates to avoid package ownership conflicts.
#
# A board package lists named firmware that must not come from Windows on its
# board, one name per line, in /usr/share/qcom-firmware-extract/provided.d/
# <device-tree compatible>.list: files the package handles itself, and files
# the machine's own boot firmware loads before Linux starts. Names listed
# for one of this machine's compatibles are never searched for, installed or
# reported missing. When nothing else is missing, the disks are not touched.
# A copy that an earlier run installed before the name was listed is left in
# place; the next --install stops recording it and prints where it is. Since
# --list-missing leaves them out, a board must not list firmware that a
# hardware check relies on, such as the ADSP image Omarchy checks before it
# enables the DSP driver, unless its package installs that file before the
# check runs.
#
# Derived from Canonical's qcom-firmware-extract (Tobias Heider, GPL-2+):
# https://salsa.debian.org/debian/qcom-firmware-extract
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

DT_ROOT=${QCOM_FW_DT_ROOT:-/sys/firmware/devicetree/base}
FW_ROOT=${QCOM_FW_FIRMWARE_ROOT:-/usr/lib/firmware}
KERNEL_CONFIG=${QCOM_FW_KERNEL_CONFIG:-/proc/config.gz}
PROVIDED_DIR=${QCOM_FW_PROVIDED_DIR:-/usr/share/qcom-firmware-extract/provided.d}
# Destination prefix for the installed-system and mount paths (tests only).
ROOT=${QCOM_FW_ROOT:-}
# The effective user ID the root checks see (tests only).
CHECKED_EUID=${QCOM_FW_TEST_EUID:-$EUID}
STATE_DIR="$ROOT/var/lib/omarchy/qcom-firmware"
MANIFEST="$STATE_DIR/manifest"
INITCPIO_CONF="$ROOT/etc/mkinitcpio.conf.d/qcom-firmware.conf"
DEFAULT_STAGE_DIR="$ROOT/var/lib/omarchy/firmware-stage"
DRIVERSTORE_PATH="Windows/System32/DriverStore/FileRepository"

mode=install
stage_dir=""
driverstore=""
rebuild=yes

usage() {
  sed -n '2,/^# SPDX/{/^# SPDX/d;s/^# \{0,1\}//p}' "$0"
}

while (($#)); do
  case $1 in
    --stage) mode=stage; stage_dir=${2:?--stage needs a directory}; shift ;;
    --stage-dir) stage_dir=${2:?--stage-dir needs a directory}; shift ;;
    --install) mode=install ;;
    --list-missing) mode=list ;;
    --retire) mode=retire ;;
    --no-rebuild) rebuild=no ;;
    -d) driverstore=${2:?-d needs a directory}; shift ;;
    -h | --help) usage; exit 0 ;;
    *) echo "qcom-firmware-extract: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

log() { printf 'qcom-firmware-extract: %s\n' "$*"; }
warn() { printf 'qcom-firmware-extract: %s\n' "$*" >&2; }
# find_in_sources prints the chosen path on stdout, so notes go to stderr.
note() { printf 'qcom-firmware-extract: %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# 1. What does this machine ask for, and what is already there?
# ---------------------------------------------------------------------------

# Prints "<node-name> <firmware path>" for every firmware-name entry in the
# device tree. A property can hold several NUL-separated strings.
dt_firmware_names() {
  local prop node name
  [[ -d $DT_ROOT ]] || return 0
  find "$DT_ROOT" -name firmware-name -type f -print0 2>/dev/null | sort -z |
    while IFS= read -r -d '' prop; do
      node=${prop%/firmware-name}
      node=${node#"$DT_ROOT"/}
      tr '\0' '\n' <"$prop" | while IFS= read -r name; do
        [[ -n $name ]] && printf '%s %s\n' "$node" "$name"
      done
    done
}

# The kernel tries plain firmware in every directory, then zstd and xz if built
# with them. gzip is not an automatic firmware-loader fallback.
firmware_suffixes=('' .zst .xz)
kernel_config_known=no
if kernel_config=$(gzip -dc -- "$KERNEL_CONFIG" 2>/dev/null); then
  kernel_config_known=yes
  firmware_suffixes=('')
  if grep -qx 'CONFIG_FW_LOADER_COMPRESS_ZSTD=y' <<<"$kernel_config"; then
    firmware_suffixes+=(.zst)
  fi
  if grep -qx 'CONFIG_FW_LOADER_COMPRESS_XZ=y' <<<"$kernel_config"; then
    firmware_suffixes+=(.xz)
  fi
fi

firmware_file() {
  local name=$1 dir ext
  for ext in "${firmware_suffixes[@]}"; do
    for dir in "$FW_ROOT/updates" "$FW_ROOT"; do
      if [[ -f "$dir/$name$ext" ]]; then
        printf '%s\n' "$dir/$name$ext"
        return 0
      fi
    done
  done
  return 1
}

# Names that board packages list for this machine as not from Windows.
declare -A provided=()
load_provided_names() {
  local compatible list line
  [[ -r $DT_ROOT/compatible && -d $PROVIDED_DIR ]] || return 0
  while IFS= read -r compatible; do
    [[ -n $compatible && $compatible != */* ]] || continue
    list="$PROVIDED_DIR/$compatible.list"
    [[ -f $list ]] || continue
    if [[ ! -r $list ]]; then
      warn "ignoring $list: it cannot be read"
      continue
    fi
    while IFS= read -r line || [[ -n $line ]]; do
      # A comment starts at a '#' that begins the line or follows a space.
      line=" $line"
      line=${line%%[[:space:]]#*}
      line=${line#"${line%%[![:space:]]*}"}
      line=${line%"${line##*[![:space:]]}"}
      [[ -n $line ]] || continue
      if [[ $line == *[[:space:]]* ]]; then
        warn "ignoring '$line' in $list: a firmware name has no spaces"
        continue
      fi
      provided[$line]=$compatible
    done <"$list"
  done < <(tr '\0' '\n' <"$DT_ROOT/compatible")
  return 0
}
load_provided_names

declare -a missing_nodes=() missing_names=() provided_names=()
while read -r node name; do
  if [[ -n ${provided[$name]-} ]]; then
    provided_names+=("$name")
    continue
  fi
  firmware_file "$name" >/dev/null && continue
  missing_nodes+=("$node")
  missing_names+=("$name")
done < <(dt_firmware_names)

if [[ $mode == list ]]; then
  ((${#missing_names[@]})) && printf '%s\n' "${missing_names[@]}"
  exit 0
fi

if [[ ! -d $DT_ROOT ]]; then
  log "no device tree on this machine, nothing to do"
  exit 0
fi
for name in "${provided_names[@]}"; do
  log "skipping $name: listed in $PROVIDED_DIR/${provided[$name]}.list"
done
if [[ $mode == stage ]] && ((${#missing_names[@]} == 0)); then
  log "every firmware file the device tree names is already installed${provided_names[*]:+ or listed for this board}"
  exit 0
fi

# Root is needed to write under /usr/lib/firmware (and, below, to mount
# partitions); staging a -d driver store into a user directory needs neither.
if [[ $CHECKED_EUID != 0 && $mode != stage ]]; then
  warn "must run as root"
  exit 1
fi

# ---------------------------------------------------------------------------
# 2. Where can they come from?
# ---------------------------------------------------------------------------

declare -a sources=()   # driver stores to search together (-d or Windows)
declare -a mounts=()    # temporary mounts to undo
stage_source=""         # the installer's stage, used before the driver stores
declare -A manifest=()  # the manifest this run updates, lines by firmware name
declare -A staged=()    # names the stage manifest lists
cleanup() {
  local m
  for m in "${mounts[@]-}"; do
    [[ -n $m ]] || continue
    umount "$m" 2>/dev/null || true
    rmdir "$m" 2>/dev/null || true
  done
}
trap cleanup EXIT

# Mount Windows driver stores read-only, preferring internal disks. With
# "internal-only", removable and external disks are left alone.
scan_windows_partitions() {
  local scope=${1:-all} dev removable hotplug fstype tran mp bitlocker="" skipped=""
  if [[ $CHECKED_EUID != 0 ]]; then
    warn "must run as root to read the Windows partitions"
    exit 1
  fi
  local -a internal=() external=()
  # read merges empty columns, so the always-set RM and HOTPLUG come first
  # and an empty TRAN comes last.
  while read -r dev removable hotplug fstype tran; do
    [[ $fstype == ntfs || $fstype == BitLocker ]] || continue
    if [[ $removable == 0 && $hotplug == 0 && $tran != usb ]]; then
      if [[ $fstype == ntfs ]]; then internal+=("$dev"); else bitlocker+=" $dev"; fi
    elif [[ $scope == internal-only ]]; then
      skipped+=" $dev"
    elif [[ $fstype == ntfs ]]; then
      external+=("$dev")
    else
      bitlocker+=" $dev"
    fi
  done < <(lsblk -rpno PATH,RM,HOTPLUG,FSTYPE,TRAN 2>/dev/null)
  [[ -z $skipped ]] || log "not reading removable or external disk partition(s):$skipped; use -d for a driver store on one"

  for dev in "${internal[@]}" "${external[@]}"; do
    mp=$(mktemp -d "$ROOT/run/qcom-firmware-extract.XXXXXX")
    if mount -t ntfs3 -o ro,nosuid,nodev,noexec "$dev" "$mp" 2>/dev/null; then
      mounts+=("$mp")
      if [[ -d "$mp/$DRIVERSTORE_PATH" ]]; then
        log "Windows driver store found on $dev"
        sources+=("$mp/$DRIVERSTORE_PATH")
      fi
    else
      warn "could not mount $dev read-only (ntfs3); skipping it"
      rmdir "$mp" 2>/dev/null || true
    fi
  done
  [[ -n $bitlocker ]] && warn "BitLocker volume(s) skipped:$bitlocker; turn BitLocker off in Windows to let the firmware be read"
  return 0
}

firmware_sha256() {
  local file=$1
  case "$file" in
    *.zst) zstd -qdc -- "$file" ;;
    *.xz) xz -dc -- "$file" ;;
    *) cat -- "$file" ;;
  esac | sha256sum | cut -d' ' -f1
}

# Match ambiguous DTBs to an installed sibling firmware blob from the same node.
matching_companion_candidate() {
  local node=$1
  shift
  local -a candidates=("$@")
  local dt_node dt_name installed installed_hash candidate sibling matched compatible
  local -a matches=()

  for candidate in "${candidates[@]}"; do
    matched=0
    compatible=1
    while read -r dt_node dt_name; do
      [[ $dt_node == "$node" ]] || continue
      installed=$(firmware_file "$dt_name") || continue
      installed_hash=$(firmware_sha256 "$installed") || return 1
      sibling=$(find "${candidate%/*}" -maxdepth 1 -type f \
        -iname "$(basename "$dt_name")" -print -quit 2>/dev/null)
      [[ -n $sibling ]] || continue
      if [[ $(sha256sum "$sibling" | cut -d' ' -f1) == "$installed_hash" ]]; then
        matched=1
      else
        compatible=0
        break
      fi
    done < <(dt_firmware_names)
    if ((matched && compatible)); then
      matches+=("$candidate")
    fi
  done

  unique_candidate "${matches[@]}"
}

node_has_installed_firmware() {
  local node=$1 dt_node dt_name
  while read -r dt_node dt_name; do
    [[ $dt_node == "$node" ]] || continue
    firmware_file "$dt_name" >/dev/null && return 0
  done < <(dt_firmware_names)
  return 1
}

# The DriverVer of the one INF in a driver package folder, as a key that sorts
# the way Windows ranks drivers: date first, then version. INFs are often
# UTF-16.
inf_driver_version() {
  local dir=$1 bom text line
  local -a infs=()
  mapfile -d '' infs < <(find "$dir" -maxdepth 1 -type f -iname '*.inf' -print0 2>/dev/null)
  ((${#infs[@]} == 1)) || return 1
  bom=$(head -c 2 -- "${infs[0]}" | od -An -tx1 | tr -d ' \n')
  case $bom in
    fffe) text=$(iconv -f UTF-16LE -t UTF-8 -- "${infs[0]}" 2>/dev/null) || return 1 ;;
    feff) text=$(iconv -f UTF-16BE -t UTF-8 -- "${infs[0]}" 2>/dev/null) || return 1 ;;
    *) text=$(<"${infs[0]}") ;;
  esac
  line=$(tr -d '\r' <<<"$text" | grep -i -m1 '^[[:space:]]*DriverVer[[:space:]]*=') || return 1
  [[ $line =~ =[[:space:]]*([0-9]{1,2})/([0-9]{1,2})/([0-9]{4})[[:space:]]*,[[:space:]]*([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+) ]] ||
    return 1
  printf '%04d%02d%02d.%05d.%05d.%05d.%05d\n' "$((10#${BASH_REMATCH[3]}))" \
    "$((10#${BASH_REMATCH[1]}))" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[4]}))" \
    "$((10#${BASH_REMATCH[5]}))" "$((10#${BASH_REMATCH[6]}))" "$((10#${BASH_REMATCH[7]}))"
}

# With no companion installed yet (a first install, while Windows keeps an
# older version of the driver package beside the one it uses), take every
# file of a node from one package: the one whose INF Windows ranks first.
# Packages that lack any of the node's files are passed over; an unreadable
# DriverVer refuses them all.
newest_package_candidate() {
  local node=$1
  shift
  local candidate dir dt_node dt_name name present key best="" sibling
  local -a matches=()
  for candidate in "$@"; do
    dir=${candidate%/*}
    present=1
    while read -r dt_node dt_name; do
      [[ $dt_node == "$node" ]] || continue
      sibling=""
      while IFS= read -r name; do
        sibling=$(find "$dir" -maxdepth 1 -type f -iname "$name" -print -quit 2>/dev/null)
        [[ -n $sibling ]] && break
      done < <(windows_firmware_names "$(basename "$dt_name")")
      [[ -n $sibling ]] || { present=0; break; }
    done < <(dt_firmware_names)
    ((present)) || continue
    key=$(inf_driver_version "$dir") || return 1
    if [[ -z $best || $key > "$best" ]]; then
      best=$key
      matches=("$candidate")
    elif [[ $key == "$best" ]]; then
      matches+=("$candidate")
    fi
  done
  unique_candidate "${matches[@]}"
}

# Duplicate copies are safe only when their contents agree.
unique_candidate() {
  (($#)) || return 1
  local first=$1 candidate
  shift
  for candidate in "$@"; do
    cmp -s "$first" "$candidate" || return 1
  done
  printf '%s\n' "$first"
}

# Windows can ship DSP device-tree images under another name: a device tree
# may ask for adsp_dtb.mbn where Windows has adsp_dtbs.elf (e.g. Surface Pro 11).
windows_firmware_names() {
  printf '%s\n' "$1"
  if [[ $1 == *_dtb.mbn ]]; then
    printf '%s\n' "${1%_dtb.mbn}_dtbs.elf"
  fi
}

# Purwa images are often named beside the Hamoa one: qcvss8380_pa.mbn next to
# qcvss8380.mbn. A name that already ends in _pa is left as it is.
pa_variant_name() {
  local name=$1 stem ext
  if [[ $name == *_pa || $name == *_pa.* ]]; then
    printf '%s\n' "$name"
    return 0
  fi
  if [[ $name == *.* ]]; then
    ext=${name##*.}
    stem=${name%.*}
    printf '%s_pa.%s\n' "$stem" "$ext"
  else
    printf '%s_pa\n' "$name"
  fi
}

is_pa_variant_name() {
  local base
  base=$(basename -- "$1")
  [[ $base == *_pa || $base == *_pa.* ]]
}

# Signing ids TrustZone compares with the fused chip. Linux socinfo's soc_id
# is a different number (555 for X1E80100, 615 for the X1P-64-100 Hamoa bin);
# those two map to the Hamoa signing id. The X1P42100's socinfo id is not in
# the kernel table, so the device-tree compatible is the equivalent.
HAMOA_SIGNING_ID=40969   # 0xa009
PURWA_SIGNING_ID=40982   # 0xa016

MBN_HELPER=""
mbn_helper_resolved=no
resolve_mbn_helper() {
  [[ $mbn_helper_resolved == yes ]] && return 0
  mbn_helper_resolved=yes
  local dir
  if [[ -n ${QCOM_FW_MBN_SOC:-} ]]; then
    if [[ -f ${QCOM_FW_MBN_SOC} ]]; then
      MBN_HELPER=$QCOM_FW_MBN_SOC
    fi
    return 0
  fi
  dir=$(dirname -- "$0")
  if [[ -f $dir/mbn-soc.py ]]; then
    MBN_HELPER=$dir/mbn-soc.py
    return 0
  fi
  if [[ -f /usr/lib/qcom-firmware-extract/mbn-soc.py ]]; then
    MBN_HELPER=/usr/lib/qcom-firmware-extract/mbn-soc.py
  fi
}

# Space-separated 0x ids, or failure when the image has none.
image_soc_ids() {
  local out
  resolve_mbn_helper
  [[ -n $MBN_HELPER ]] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  out=$(python3 "$MBN_HELPER" --ids "$1" 2>/dev/null) || return 1
  [[ -n $out ]] || return 1
  printf '%s\n' "$out"
}

signed_ids_text() {
  local ids
  if ids=$(image_soc_ids "$1"); then
    printf 'signed for %s\n' "${ids// /, }"
  else
    printf 'no SoC id\n'
  fi
}

# Decimal chip id from QCOM_FW_SOC_ID, or from soc_id. Accepts 40982 and 0xa016.
# A test root does not fall through to the host's soc_id.
read_soc_id_number() {
  local raw="" file
  local -a files=()
  if [[ -n ${QCOM_FW_SOC_ID:-} ]]; then
    raw=$QCOM_FW_SOC_ID
  else
    [[ -n ${QCOM_FW_SOC_ID_FILE:-} ]] && files+=("$QCOM_FW_SOC_ID_FILE")
    if [[ -n $ROOT ]]; then
      files+=("$ROOT/sys/devices/soc0/soc_id")
    else
      files+=("/sys/devices/soc0/soc_id")
    fi
    for file in "${files[@]}"; do
      [[ -r $file ]] || continue
      raw=$(tr -d '[:space:]' <"$file")
      [[ -n $raw ]] && break
    done
  fi
  [[ -n $raw ]] || return 1
  if [[ $raw =~ ^[0-9]+$ ]]; then
    printf '%u\n' "$((10#$raw))"
  elif [[ $raw =~ ^0[xX][0-9a-fA-F]+$ ]]; then
    printf '%u\n' "$((raw))"
  else
    return 1
  fi
}

signing_id_for_socinfo() {
  case $1 in
    555 | 615) printf '%s\n' "$HAMOA_SIGNING_ID" ;;
    *) return 1 ;;
  esac
}

# The first known qcom compatible wins, so qcom,x1p42100 is not shadowed by
# the qcom,x1e80100 fallback listed after it.
signing_id_from_devicetree() {
  local compatible
  [[ -r $DT_ROOT/compatible ]] || return 1
  while IFS= read -r compatible; do
    case $compatible in
      qcom,x1p42100) printf '%s\n' "$PURWA_SIGNING_ID"; return 0 ;;
      qcom,x1p64100 | qcom,x1e80100) printf '%s\n' "$HAMOA_SIGNING_ID"; return 0 ;;
    esac
  done < <(tr '\0' '\n' <"$DT_ROOT/compatible")
  return 1
}

# Decimal ids this machine should match, one per line. A known socinfo id is
# the silicon and is not mixed with a different device-tree id. The raw
# soc_id is included too, so a file signed for that number still matches.
running_chip_ids() {
  local raw mapped compatible_id
  local -a ids=()
  declare -A seen=()
  if raw=$(read_soc_id_number); then
    ids+=("$raw")
    seen[$raw]=1
    if mapped=$(signing_id_for_socinfo "$raw"); then
      if [[ -z ${seen[$mapped]-} ]]; then
        ids+=("$mapped")
      fi
      printf '%s\n' "${ids[@]}"
      return 0
    fi
  fi
  if compatible_id=$(signing_id_from_devicetree); then
    if [[ -z ${seen[$compatible_id]-} ]]; then
      ids+=("$compatible_id")
    fi
  fi
  ((${#ids[@]})) || return 1
  printf '%s\n' "${ids[@]}"
}

chip_desc() {
  local id text=""
  local -a chips=()
  mapfile -t chips < <(running_chip_ids || true)
  ((${#chips[@]})) || { printf '%s\n' unknown; return 0; }
  for id in "${chips[@]}"; do
    [[ -n $text ]] && text+=', '
    text+=$(printf '0x%x' "$id")
  done
  printf '%s\n' "$text"
}

# Sets chosen and soc_reason (match, inconclusive, none, many). A result is
# conclusive only when every candidate yields SoC ids and the running chip is
# known. chosen is the caller's variable, via bash's dynamic scope.
select_signed_candidate() {
  local cand ids chip id matched parsed_all=1
  local -a running=() matching=()
  chosen=""
  soc_reason=inconclusive
  mapfile -t running < <(running_chip_ids || true)
  ((${#running[@]})) || return 1
  for cand in "$@"; do
    ids=$(image_soc_ids "$cand") || { parsed_all=0; break; }
  done
  ((parsed_all)) || return 1
  for cand in "$@"; do
    ids=$(image_soc_ids "$cand")
    matched=0
    for id in $ids; do
      for chip in "${running[@]}"; do
        if [[ $((id)) -eq $chip ]]; then
          matched=1
        fi
      done
    done
    if ((matched)); then
      matching+=("$cand")
    fi
  done
  if ((${#matching[@]} == 0)); then
    soc_reason=none
    return 1
  fi
  if chosen=$(unique_candidate "${matching[@]}"); then
    soc_reason=match
    return 0
  fi
  soc_reason=many
  chosen=""
  return 1
}

# Name fallback used only when signature parsing is not conclusive. Purwa
# (0xa016) takes the _pa names; any other known chip takes the rest. It has
# to exclude something, and the files it keeps have to agree.
select_by_pa_name() {
  local cand chip purwa=0
  local -a running=() chosen_set=()
  chosen=""
  mapfile -t running < <(running_chip_ids || true)
  ((${#running[@]})) || return 1
  for chip in "${running[@]}"; do
    [[ $chip -eq $PURWA_SIGNING_ID ]] && purwa=1
  done
  for cand in "$@"; do
    if ((purwa)); then
      is_pa_variant_name "$cand" && chosen_set+=("$cand")
    else
      is_pa_variant_name "$cand" || chosen_set+=("$cand")
    fi
  done
  ((${#chosen_set[@]})) || return 1
  ((${#chosen_set[@]} == $#)) && return 1
  chosen=$(unique_candidate "${chosen_set[@]}") || return 1
}

warn_ambiguous() {
  local base=$1 why=$2
  shift 2
  local cand
  case $why in
    none)
      warn "refusing ambiguous $base: running chip $(chip_desc) matches none of these candidates"
      ;;
    many)
      warn "refusing ambiguous $base: running chip $(chip_desc) matches more than one of these candidates"
      ;;
    *)
      warn "refusing ambiguous $base: running chip $(chip_desc); signature SoC ids did not select one of these candidates"
      ;;
  esac
  for cand in "$@"; do
    warn "  candidate $cand ($(signed_ids_text "$cand"))"
  done
}

# Require one variant when several firmware files match. Returns 1 when the
# sources have no candidate and 2 when it refuses ambiguous ones. chosen and
# soc_reason belong to this function; the selectors assign them.
find_in_sources() {
  local base=$1 node=$2 candidate name pa
  local chosen="" soc_reason=""
  local -a candidates=()
  while IFS= read -r name; do
    while IFS= read -r -d '' candidate; do
      candidates+=("$candidate")
    done < <(find "${sources[@]}" -type f -iname "$name" -print0 2>/dev/null)
    if ((${#candidates[@]})); then
      pa=$(pa_variant_name "$name")
      if [[ $pa != "$name" ]]; then
        while IFS= read -r -d '' candidate; do
          candidates+=("$candidate")
        done < <(find "${sources[@]}" -type f -iname "$pa" -print0 2>/dev/null)
      fi
      break
    fi
  done < <(windows_firmware_names "$base")

  ((${#candidates[@]})) || return 1
  if unique_candidate "${candidates[@]}"; then
    return 0
  fi

  if select_signed_candidate "${candidates[@]}"; then
    note "selected $base from $chosen: $(signed_ids_text "$chosen"), running chip $(chip_desc)"
    printf '%s\n' "$chosen"
    return 0
  fi

  # none and many are answers. The _pa name is only a fallback when the
  # signatures themselves could not be compared.
  if [[ $soc_reason == none || $soc_reason == many ]]; then
    warn_ambiguous "$base" "$soc_reason" "${candidates[@]}"
    return 2
  fi

  if select_by_pa_name "${candidates[@]}"; then
    note "selected $base from $chosen: _pa variant name, running chip $(chip_desc); signature SoC ids were not conclusive"
    printf '%s\n' "$chosen"
    return 0
  fi

  if matching_companion_candidate "$node" "${candidates[@]}"; then
    return 0
  fi

  if ! node_has_installed_firmware "$node" && newest_package_candidate "$node" "${candidates[@]}"; then
    return 0
  fi

  warn_ambiguous "$base" "$soc_reason" "${candidates[@]}"
  return 2
}

# A manifest has one line per firmware name: the name, the SHA-256 of the file
# and where it came from. Loads FILE as the manifest this run updates.
read_manifest() {
  local line name
  manifest=()
  while IFS= read -r line || [[ -n $line ]]; do
    read -r name _ <<<"$line"
    if [[ -n $name ]]; then
      manifest[$name]=$line
    fi
  done <"$1"
}

# Sets NAME's manifest line to NAME followed by FIELDS; without FIELDS, removes
# it.
set_manifest_line() {
  local name=$1
  shift
  if (($#)); then
    manifest[$name]="$name $*"
  else
    unset 'manifest[$name]'
  fi
}

write_manifest() {
  if ((${#manifest[@]})); then
    printf '%s\n' "${manifest[@]}" | sort >"$1.new"
  else
    : >"$1.new"
  fi
  mv "$1.new" "$1"
}

# A file in DIR counts as staged when the stage manifest lists it. In --stage
# mode, that manifest is also the one the run updates.
use_stage() {
  local name
  stage_source=$1
  read_manifest "$1/manifest"
  for name in "${!manifest[@]}"; do
    staged[$name]=1
  done
}

is_staged() {
  [[ -n ${staged[$1]-} && -f $stage_source/$1 ]]
}

# True if the stage lacks any of the missing files.
stage_incomplete() {
  local name
  for name in "${missing_names[@]}"; do
    is_staged "$name" || return 0
  done
  return 1
}

# The stage comes first; the driver stores supply what it lacks. A staged file
# listed under another device-tree path with the same file name (a later device
# tree may move it) is the last resort, since after a full-disk install the
# stage is the only copy.
locate_firmware() {
  local name=$1 node=$2 src status=0
  if is_staged "$name"; then
    printf '%s\n' "$stage_source/$name"
    return 0
  fi
  if ((${#sources[@]})); then
    src=$(find_in_sources "$(basename "$name")" "$node") || status=$?
    if ((status == 0)); then
      printf '%s\n' "$src"
      return 0
    fi
    # The stage does not override a refusal of ambiguous variants.
    ((status != 2)) || return 1
  fi
  [[ -n $stage_source ]] || return 1
  local -a sources=("$stage_source")
  src=$(find_in_sources "$(basename "$name")" "$node") || return 1
  is_staged "${src#"$stage_source"/}" || return 1
  printf '%s\n' "$src"
}

# Lists the GPU zap shaders the device tree names, wherever they are installed,
# in the initramfs for the early DRM driver. Sets initramfs_changed when the
# configuration changes.
update_initramfs_config() {
  local node name file initramfs_config
  local -a initramfs_files=()
  while read -r node name; do
    [[ ${node##*/} == zap-shader || ${node##*/} == zap-shader@* ]] || continue
    if file=$(firmware_file "$name"); then
      initramfs_files+=("${file#"$ROOT"}")
    fi
  done < <(dt_firmware_names)
  initramfs_changed=0
  if ((${#initramfs_files[@]})); then
    initramfs_config=$(
      echo "# Generated by qcom-firmware-extract for early DRM firmware loading."
      printf 'FILES+=(%s)\n' "$(printf '%q ' "${initramfs_files[@]}" | sed 's/ $//')"
    )
    if [[ ! -f $INITCPIO_CONF || $(<"$INITCPIO_CONF") != "$initramfs_config" ]]; then
      mkdir -p "$(dirname "$INITCPIO_CONF")"
      printf '%s\n' "$initramfs_config" >"$INITCPIO_CONF"
      initramfs_changed=1
    fi
  elif [[ -f $INITCPIO_CONF ]]; then
    rm -f "$INITCPIO_CONF"
    initramfs_changed=1
  fi
}

rebuild_boot_image() {
  if command -v limine-update >/dev/null 2>&1; then
    limine-update
  else
    mkinitcpio -P
  fi
}

# The packaged file for NAME, ignoring /usr/lib/firmware/updates. Without the
# kernel's configuration a compressed file may not load, so only a plain one
# counts.
packaged_firmware_file() {
  local name=$1 ext
  local -a suffixes=("${firmware_suffixes[@]}")
  [[ $kernel_config_known == "yes" ]] || suffixes=('')
  for ext in "${suffixes[@]}"; do
    if [[ -f "$FW_ROOT/$name$ext" ]]; then
      printf '%s\n' "$FW_ROOT/$name$ext"
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# Retire: packaged firmware caught up with what was copied from Windows
# ---------------------------------------------------------------------------

# A node's files are a set: a DSP image and its device-tree image must come
# from the same release. A node's copies are removed together, once packages
# ship every file it names, and only if every copy in it can go: one this tool
# recorded, unchanged since, a plain file in /usr/lib/firmware/updates, not
# listed for this board in provided.d. Otherwise the node keeps all of them, so
# it never loads a mix of releases. Nodes that share a name are tied: when one
# keeps its copies, every node linked to it through shared names keeps them.

# True if the copy of NAME in updates is one this tool installed, unchanged.
retirable_copy() {
  local name=$1 copy updates packaged recorded
  copy="$FW_ROOT/updates/$name"
  [[ -z ${provided[$name]-} && -n ${manifest[$name]-} && -f $copy && ! -L $copy ]] || return 1
  # The copy must really sit in updates, not behind a symlinked directory, and
  # the packaged file must not lead back into updates.
  updates=$(realpath -e -- "$FW_ROOT/updates") || return 1
  [[ $(realpath -e -- "$copy") == "$updates/$name" ]] || return 1
  packaged=$(packaged_firmware_file "$name") || return 1
  [[ $(realpath -e -- "$packaged") != "$updates"/* ]] || return 1
  read -r _ recorded _ <<<"${manifest[$name]}"
  [[ $(sha256sum <"$copy" | cut -d' ' -f1) == "$recorded" ]]
}

if [[ $mode == retire ]]; then
  declare -A node_retirable=() name_nodes=()
  declare -a retiring=()
  manifest=()
  if [[ -f $MANIFEST ]]; then
    read_manifest "$MANIFEST"
  fi
  while read -r node name; do
    [[ -n ${node_retirable[$node]-} ]] || node_retirable[$node]=yes
    name_nodes[$name]+=$node$'\n'
    # A provided name with no file, such as one the boot firmware loads,
    # does not hold its node back.
    if [[ -z ${provided[$name]-} ]] && ! packaged_firmware_file "$name" >/dev/null; then
      node_retirable[$node]=no
    fi
    copy="$FW_ROOT/updates/$name"
    if [[ -e $copy || -L $copy ]] && ! retirable_copy "$name"; then
      node_retirable[$node]=no
    fi
  done < <(dt_firmware_names)

  # A node that keeps its copies keeps every name it shares, so the nodes
  # sharing those names keep theirs too, until nothing changes.
  changed=1
  while ((changed)); do
    changed=0
    for name in "${!name_nodes[@]}"; do
      blocked=no
      while IFS= read -r node; do
        [[ -z $node || ${node_retirable[$node]} == "yes" ]] || blocked=yes
      done <<<"${name_nodes[$name]}"
      [[ $blocked == "yes" ]] || continue
      while IFS= read -r node; do
        if [[ -n $node && ${node_retirable[$node]} == "yes" ]]; then
          node_retirable[$node]=no
          changed=1
        fi
      done <<<"${name_nodes[$name]}"
    done
  done

  while IFS= read -r name; do
    [[ -n $name ]] || continue
    retire=yes
    while IFS= read -r node; do
      [[ -z $node || ${node_retirable[$node]} == "yes" ]] || retire=no
    done <<<"${name_nodes[$name]}"
    [[ $retire == "yes" ]] || continue
    copy="$FW_ROOT/updates/$name"
    if [[ -e $copy || -L $copy ]]; then
      retiring+=("$name")
    fi
    if [[ -n ${manifest[$name]-} ]]; then
      set_manifest_line "$name"
    fi
  done < <(printf '%s\n' "${!name_nodes[@]}" | sort)

  # The manifest stops recording a copy before it is removed: if removing
  # fails, a file is left unrecorded and kept, never recorded and gone.
  if [[ -f $MANIFEST ]]; then
    write_manifest "$MANIFEST"
  fi
  for name in "${retiring[@]}"; do
    copy="$FW_ROOT/updates/$name"
    rm -f -- "$copy"
    dir=${copy%/*}
    while [[ $dir != "$FW_ROOT/updates" ]] && rmdir -- "$dir" 2>/dev/null; do
      dir=${dir%/*}
    done
    log "retired $copy: packaged firmware now ships $name"
  done
  for name in "${!name_nodes[@]}"; do
    copy="$FW_ROOT/updates/$name"
    if [[ -n ${manifest[$name]-} && -z ${provided[$name]-} ]] && [[ -e $copy || -L $copy ]] &&
      packaged_firmware_file "$name" >/dev/null && ! retirable_copy "$name"; then
      warn "keeping $copy and the other copies of its node: it is not the unchanged file this tool installed"
    fi
  done
  if ((${#retiring[@]} == 0)); then
    log "no copy to retire"
  fi

  # Also repairs the zap shader's entry when a packaged shader changed format.
  update_initramfs_config
  if ((${#retiring[@]} || initramfs_changed)) && [[ $rebuild == yes ]]; then
    rebuild_boot_image
    log "reboot to load the packaged firmware"
  fi
  exit 0
fi

# ---------------------------------------------------------------------------
# 3. Stage: live session, before the disk is written
# ---------------------------------------------------------------------------

if [[ $mode == stage ]]; then
  # Files staged by an earlier run are kept; a rerun, for example with -d,
  # looks only for the rest, so an empty or partial stage blocks nothing.
  if [[ -f "$stage_dir/manifest" ]]; then
    use_stage "$stage_dir"
  fi
  if ! stage_incomplete; then
    log "already staged in $stage_dir"
    exit 0
  fi
  if [[ -n $driverstore ]]; then
    sources=("$driverstore")
  elif [[ -n $stage_source && $CHECKED_EUID != 0 ]]; then
    # Without root the partitions cannot be read; keep the stage as it is.
    log "already staged in $stage_dir; run as root to read the Windows partitions for the rest"
    exit 0
  else
    scan_windows_partitions
  fi
  mkdir -p "$stage_dir"
  copied=0
  kept=0
  for i in "${!missing_names[@]}"; do
    node=${missing_nodes[$i]}
    name=${missing_names[$i]}
    if is_staged "$name"; then
      kept=$((kept + 1))
      continue
    fi
    src=""
    if ((${#sources[@]})); then
      src=$(find_in_sources "$(basename "$name")" "$node") || true
    fi
    if [[ -z $src ]]; then
      warn "not found in the driver store: $name"
      continue
    fi
    install -Dm644 "$src" "$stage_dir/$name"
    set_manifest_line "$name" "$(sha256sum "$src" | cut -d' ' -f1)" "$src"
    copied=$((copied + 1))
  done
  write_manifest "$stage_dir/manifest"
  log "staged $copied of ${#missing_names[@]} firmware files in $stage_dir ($kept already staged)"
  exit 0
fi

# ---------------------------------------------------------------------------
# 4. Install: from the stage, else from a Windows partition still on disk
# ---------------------------------------------------------------------------

[[ -n $stage_dir ]] || stage_dir=$DEFAULT_STAGE_DIR
if [[ -n $driverstore ]]; then
  sources=("$driverstore")
else
  # Windows supplies what the stage lacks, so a stage never hides it.
  if [[ -f "$stage_dir/manifest" ]]; then
    log "using the firmware staged by the installer in $stage_dir"
    use_stage "$stage_dir"
  fi
  # After installation, only internal disks are read; -d reads any other.
  if stage_incomplete; then
    scan_windows_partitions internal-only
  fi
fi

mkdir -p "$STATE_DIR"
touch "$MANIFEST"
read_manifest "$MANIFEST"

# A board may list a name after an earlier run installed it. That copy still
# loads first, but this tool never deletes it: matching bytes would not prove
# that the file is still the one it installed, since a board's own tool may
# keep the same file there. Stop recording it and say where it is.
for name in "${provided_names[@]}"; do
  [[ -n ${manifest[$name]-} ]] || continue
  set_manifest_line "$name"
  write_manifest "$MANIFEST"
  file="$FW_ROOT/updates/$name"
  if [[ -e $file || -L $file ]]; then
    log "note: an earlier run installed $file, but $name is now listed in $PROVIDED_DIR/${provided[$name]}.list; the file is left in place and no longer recorded"
    log "note: while it is there it loads before any other copy. The board package may remove it, or you can by hand. This tool does not, because matching bytes would not prove that the file is still the one it installed: a board's own tool may keep the same file there."
  fi
done

installed=0
for i in "${!missing_names[@]}"; do
  node=${missing_nodes[$i]}
  name=${missing_names[$i]}
  src=$(locate_firmware "$name" "$node") || true
  if [[ -z $src ]]; then
    warn "not found: $name"
    continue
  fi
  install -Dm644 "$src" "$FW_ROOT/updates/$name"
  # Record each file as soon as it is in place.
  set_manifest_line "$name" "$(sha256sum "$src" | cut -d' ' -f1)" "$src" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_manifest "$MANIFEST"
  log "installed $name"
  installed=$((installed + 1))
done

update_initramfs_config

still_missing=$(( ${#missing_names[@]} - installed ))
if ((installed == 0)); then
  if ((still_missing > 0 && ${#sources[@]} == 0)); then
    warn "no Windows installation found to copy from; run again with -d <driver store> when one is available"
  fi
  log "nothing installed; $still_missing firmware file(s) still missing"
  ((initramfs_changed)) || exit 0
else
  log "installed $installed firmware file(s), $still_missing still missing"
fi

if [[ $rebuild == yes ]]; then
  rebuild_boot_image
  log "reboot to load the added firmware"
fi
